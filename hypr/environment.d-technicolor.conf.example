# Copy to ~/.config/environment.d/technicolor.conf
# Loaded by systemd at session start → applies to D-Bus / systemd-launched apps
# (the app launcher, .desktop Exec entries), which is how LibreOffice is invoked.
# SAL_USE_VCLPLUGIN=kf6 makes LibreOffice use the KF6 VCL plugin so it reads
# kdeglobals and recolors with the Technicolor palette (same source as Dolphin),
# instead of the gtk3 plugin which caches its colors at launch and looks off.
# Mirrored in hyprland.conf (env = SAL_USE_VCLPLUGIN,kf6) for Hyprland-spawned
# launches. Requires the kf6 VCL plugin (libvclplug_kf6lo.so — part of the
# libreoffice-kf6/-qt6 package on most distros). LibreOffice repaints on
# relaunch, not live.
SAL_USE_VCLPLUGIN=kf6
