# Written by Settings → Glass (the sliders + write-in). hyprland.conf sources
# this AFTER the plugin defaults, so any line here overrides them. Empty = defaults.
# Examples:
# plugin:hyprwater:refraction_strength = 1.5
# plugin:hyprwater:blur_strength = 0.4
# plugin:hyprwater:chromatic_aberration = 0.0

# Glass the quickshell bar's section pills (minimized apps, tray, workspace
# dots, launcher) the same way windows are glassed. The mask threshold keeps the
# effect on the pills themselves rather than the transparent gaps between them.
# Only visible where the wallpaper behind the bar actually has detail to blur.
#
# Keep the threshold well BELOW the pills' own alpha. The pills follow the
# terminal transparency slider, so at 91% see-through they are 0.09 opaque — a
# threshold of 0.1 masks them out and the glass silently vanishes from exactly
# the areas you wanted it (the opaque icons keep theirs, which is what makes it
# look like a bug rather than a setting). 0.002 leaves headroom to 99.8%.
plugin:hyprwater:layers:enabled = 1
# NOTE: this REPLACES the list in hyprland.conf, it does not add to it. Keep
# quickshell:pie and wofi here or the alt-tab pie and the wofi menu lose their
# glass — which is exactly what happened when this line first said only the bar.
plugin:hyprwater:layers:namespaces = quickshell:pie, wofi, quickshell:bar
plugin:hyprwater:layers:namespace_mask_thresholds = quickshell:pie=0.03, wofi=0.03, quickshell:bar=0.002

# Per-pixel adaptive tint: wherever the backdrop showing through the glass is
# brighter than adaptive_target, tint exactly enough to bring it down to that
# luma; darker backdrops get no tint at all. Computed in the glass shader from
# the backdrop it already samples — per-pixel, per-frame, no polling. This is
# what Settings → System → "Adapt to what's behind" drives.
plugin:hyprwater:adaptive_tint = 1
plugin:hyprwater:adaptive_target = 0.18
# Seconds for the dim to settle. One value is computed per WINDOW (not per
# pixel), so identical content always renders identically; this is how long it
# takes to respond. Animated wallpapers move the window average every frame —
# without this the dim would pump with the animation.
plugin:hyprwater:adaptive_speed = 2.0
