
# ---- Nvidia ----
# The standard Hyprland-on-Nvidia set (full story: Hyprland wiki -> Nvidia).
# Driver: nvidia-open-dkms (Turing/GTX16xx+) or nvidia-dkms, plus nvidia-utils
# (+ lib32-nvidia-utils for Steam); nvidia_drm.modeset=1 is default on recent
# drivers. The bar's GPU usage/VRAM/temp need no config — they auto-detect
# amdgpu sysfs first, then fall back to nvidia-smi.
# env = LIBVA_DRIVER_NAME,nvidia
# env = __GLX_VENDOR_LIBRARY_NAME,nvidia
# env = ELECTRON_OZONE_PLATFORM_HINT,auto
# cursor {
#     no_hardware_cursors = true
# }

# ---- Hypr-DarkWindow chroma-key glass (Spotify / Dolphin / Brave) ----
# These register the keyer shaders and bind them per app-class. They live here
# (not hyprland.conf) because the plugin needs an ABSOLUTE shader path with no
# ~ expansion — REPLACE /home/YOU with your home dir. Requires the
# Hypr-DarkWindow hyprpm plugin (see hyprland.conf's plugin = line). Uncomment
# the blocks you want.
#
# Spotify: theme paints the bg the key colour; this keys it to glass. The
# self-calibrating keyer samples a corner pixel as the key (fine — Spotify's
# only window is the main one). KEY = #7A6E85 (set by gen-spotify-theme.py).
# plugin:darkwindow:shader[tckey] {
#     path = /home/YOU/.config/hypr/technicolor-chromakey.glsl
#     args = sim=0.012 choke=0.65
#     introduces_transparency = true
# }
# windowrule = darkwindow:shade tckey, match:class ^([Ss]potify)$
#
# Dolphin: FIXED key (rgb 1,186,188) passed as a uniform — the class rule also
# matches Dolphin's dialogs, and a self-calibrating keyer would sample a
# dialog's corner (a solid surface) as the key and key the whole dialog away.
# plugin:darkwindow:shader[tckeydolph] {
#     path = /home/YOU/.config/hypr/technicolor-chromakey-dolphin.glsl
#     args = sim=0.012 choke=0.65 keyc=[0.003922 0.729412 0.737255]
#     introduces_transparency = true
# }
# windowrule = darkwindow:shade tckeydolph, match:class ^(org.kde.dolphin)$
#
# LibreOffice (OPTIONAL glass): by default lo-recolor.py fills the gutter (the
# blank area around the white page) with a SOLID color matching the chrome, so
# the page sits in a cohesive colored frame. If you'd rather make that gutter
# TRANSPARENT glass instead (the page floats over the desktop — looks striking
# but isolated), run lo-recolor.py with "glass" (it sets AppBackground to the
# fixed key rgb(1,186,188)) AND add the windowrules below so the shared
# tckeydolph keyer makes just the gutter transparent (page/chrome/content have
# no key pixels, so only the gutter keys):
# windowrule = darkwindow:shade tckeydolph, match:class ^(libreoffice-writer)$
# windowrule = darkwindow:shade tckeydolph, match:class ^(libreoffice-calc)$
# windowrule = darkwindow:shade tckeydolph, match:class ^(libreoffice-impress)$
# windowrule = darkwindow:shade tckeydolph, match:class ^(libreoffice-draw)$
# windowrule = darkwindow:shade tckeydolph, match:class ^(libreoffice-startcenter)$
#
# Brave: BAND-LIMITED keyer — only the top `band` window pixels (the tab strip
# the generated theme paints in the key) are keyable; web content below is
# never touched. fullscreen 0 excludes fullscreen (chrome hidden there). Pair
# with gen-brave-theme.py's theme (frame = the key). band ≈ tab-strip height.
# plugin:darkwindow:shader[tckeybrave] {
#     path = /home/YOU/.config/hypr/technicolor-chromakey-brave.glsl
#     args = sim=0.012 choke=0.65 keyc=[0.003922 0.729412 0.737255] band=44.0
#     introduces_transparency = true
# }
# windowrule = darkwindow:shade tckeybrave, match:class ^(brave-browser)$, match:fullscreen 0
