# QS_THEME_BEGIN
# (managed by ~/.config/quickshell/notif-theme-mako.sh — regenerated on wallpaper change)
default-timeout=7000
on-notify=exec ~/.config/quickshell/notif-bump.sh "$id"
font=JetBrainsMono Nerd Font 11
background-color=#B8C8B7F0
text-color=#000000
border-color=#B8C8B7F0
border-size=2
border-radius=12
padding=14
margin=12
width=380
max-visible=3
layer=overlay
anchor=top-right
# QS_THEME_END

[urgency=low]
border-color=#A6E3A1CC

[urgency=high]
border-color=#F38BA8CC
default-timeout=0

# QS_SILENCE_BEGIN
# (managed by ~/.config/quickshell/notif-silence.sh — do not edit by hand)
[desktop-entry=org.kde.kded6]
invisible=1
[app-name="Network Management"]
invisible=1
[app-name="blueman"]
invisible=1
[app-name="tray-icon"]
invisible=1
[app-name="Cachy-Update"]
invisible=1

# QS_SILENCE_END
