# Per-machine / personal — created by install.sh or the Settings app from the
# .example files (sensible defaults apply when absent)
hypr/local.conf
hypr/monitors.conf
hypr/colors.conf
hypr/color-tuning.conf
hypr/hyprglass-tuning.conf
hypr/wallpaper-dir.conf
hypr/window-geometry.conf
hypr/workspaces.conf
hypr/font.conf
hypr/wofi/font.css
quickshell/colors.env
quickshell/launcher-apps.json
hypr/.technicolor-version
mako/config

# Runtime state
quickshell/silenced-apps.json
quickshell/silenced-apps.json.lock
hypr/__pycache__/
quickshell/__pycache__/
*.working

# Editor / backup noise
*.bak
*.bak*
*~
*.swp

# Nested theme-repo metadata (the wofi theme is vendored, not a submodule)
hypr/wofi/repo/.git/

# hyprglass plugin build artifacts (BSD-3 source is vendored; hyprglass/load.sh
# compiles it locally on first run, so the binary/objects are never committed)
hypr/hyprglass/hyprglass.so
hypr/hyprglass/src/*.o
